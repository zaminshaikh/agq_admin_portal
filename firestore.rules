rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public branding and copy are needed before sign-in. All writes go through
    // admin-only callables with validation and conflict checks.
    match /appContent/published {
      allow read: if true;
      allow write: if false;
    }
    // Preserve existing application access while excluding managed content.
    match /{collection}/{document=**} {
      allow read, write: if collection != 'appContent';
    }
  }
}
